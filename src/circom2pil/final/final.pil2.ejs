function pow7(const expr input): const expr {
    const expr input2 = input * input;
    const expr input4 = input2 * input2;
    const expr input6 = input4 * input2;
    return input6 * input;
}


function poseidonInputOrder(const expr a[], const expr b[], const expr out[], const expr POSEIDONSPONGE, const expr POSEIDONCOMPRESSION) {
    POSEIDONCOMPRESSION * b[0] * (b[0] - 1) === 0;
    POSEIDONCOMPRESSION * b[1] * (b[1] - 1) === 0;
    
    const expr mask00 = (1 - b[0]) * (1 - b[1]);
    const expr mask10 = b[0] * (1 - b[1]);
    const expr mask01 = (1 - b[0]) * b[1];
    const expr mask11 = b[0] * b[1];

    const expr input[POSEIDON_WIDTH];

    // CASE b[0] = 0, b[1] = 0: input = [a0, a1, a2, a3, a4, a5, a6,  a7,  a8,  a9,  a10, a11, a12, a13, a14, a15]
    // CASE b[0] = 1, b[1] = 0: input = [a4, a5, a6, a7, a0, a1, a2,  a3,  a8,  a9,  a10, a11, a12, a13, a14, a15]
    // CASE b[0] = 0, b[1] = 1: input = [a4, a5, a6, a7, a8, a9, a10, a11, a0,  a1,  a2,  a3,  a12, a13, a14, a15]
    // CASE b[0] = 1, b[1] = 1: input = [a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a0,  a1,  a2,  a3]

    for (int i = 0; i < POSEIDON_WIDTH; i++) {
        if(i < 4) {
            // 00 -> a[i]
            // 10 -> a[i + 4]
            // 01 -> a[i + 4]
            // 11 -> a[i + 4]
            input[i] = POSEIDONCOMPRESSION * (mask00 * a[i] + (mask10 + mask01 + mask11) * a[i + 4]) + POSEIDONSPONGE * a[i];
        } else if (i < 8) {
            // 00 -> a[i]
            // 10 -> a[i - 4]
            // 01 -> a[i + 4]
            // 11 -> a[i + 4]
            input[i] = POSEIDONCOMPRESSION * (mask00 * a[i] + mask10 * a[i - 4] + (mask01 + mask11) * a[i + 4]) + POSEIDONSPONGE * a[i];
        } else if (i < 12) {
            // 00 -> a[i]
            // 10 -> a[i]
            // 01 -> a[i - 8]
            // 11 -> a[i + 4]
            input[i] = POSEIDONCOMPRESSION * ((mask00 + mask10) *a[i] + mask01 * a[i - 8] + mask11 * a[i + 4]) + POSEIDONSPONGE * a[i];
        } else {
            // 00 -> a[i]
            // 10 -> a[i]
            // 01 -> a[i]
            // 11 -> a[i - 12]
            input[i] = POSEIDONCOMPRESSION * ((mask00 + mask10 + mask01) * a[i] + mask11 * a[i - 12]) + POSEIDONSPONGE * a[i];
        }
    }

    poseidonFullRound(input, out, POSEIDONSPONGE + POSEIDONCOMPRESSION);
}

function poseidonFullRound(const expr input[], const expr output[], const expr sel) {
    const expr mat[POSEIDON_WIDTH];

    const expr t0[POSEIDON_WIDTH/HASH_SIZE], t1[POSEIDON_WIDTH/HASH_SIZE], t2[POSEIDON_WIDTH/HASH_SIZE], t3[POSEIDON_WIDTH/HASH_SIZE];
    for (int i = 0; i < POSEIDON_WIDTH/HASH_SIZE; i++) {
        t0[i] = input[4*i] + input[4*i + 1];
        t1[i] = input[4*i + 2] + input[4*i + 3];
        t2[i] = 2*input[4*i + 1] + t1[i];
        t3[i] = 2*input[4*i + 3] + t0[i];
        
        mat[4*i + 3] = 4*t1[i] + t3[i];
        mat[4*i + 1] = 4*t0[i] + t2[i];
        mat[4*i] = t3[i] + mat[4*i + 1];
        mat[4*i + 2] = t2[i] + mat[4*i + 3];
       
    }

    const expr stored[HASH_SIZE];
    for (int i = 0; i < HASH_SIZE; i++) {
        stored[i] = mat[i] + mat[i+4] + mat[i+8] + mat[i+12];
    }

    for (int i = 0; i < POSEIDON_WIDTH; i++) {
        sel * (output[i] -  (mat[i] + stored[i%HASH_SIZE])) === 0;
    }
}

function poseidonPartialRound(const int rounds, const expr input[], const expr output[], const expr st0[], const expr intermediateValues[], const expr sel) {
    const expr sR[rounds + 1][POSEIDON_WIDTH];
    const expr sum_partial[rounds];
    for (int i = 0; i < POSEIDON_WIDTH; ++i) {
        sR[0][i] = input[i];
    }

    for (int i = 0; i < rounds; i++) {
        sel * (st0[i] - sR[i][0]) === 0;
        sum_partial[i] = intermediateValues[i] + sR[i][1] + sR[i][2] + sR[i][3] + sR[i][4] + sR[i][5] + sR[i][6] + sR[i][7] + sR[i][8] + sR[i][9] + sR[i][10] + sR[i][11] + sR[i][12] + sR[i][13] + sR[i][14] + sR[i][15];
        
        sR[i+1][0] = intermediateValues[i] * POSEIDON_DIAG[0] + sum_partial[i];
        sR[i+1][1] = sR[i][1] * POSEIDON_DIAG[1] + sum_partial[i];
        sR[i+1][2]  = sR[i][2] * POSEIDON_DIAG[2] + sum_partial[i];
        sR[i+1][3]  = sR[i][3] * POSEIDON_DIAG[3] + sum_partial[i];
        sR[i+1][4]  = sR[i][4] * POSEIDON_DIAG[4] + sum_partial[i];
        sR[i+1][5]  = sR[i][5] * POSEIDON_DIAG[5] + sum_partial[i];
        sR[i+1][6]  = sR[i][6] * POSEIDON_DIAG[6] + sum_partial[i];
        sR[i+1][7]  = sR[i][7] * POSEIDON_DIAG[7] + sum_partial[i];
        sR[i+1][8]  = sR[i][8] * POSEIDON_DIAG[8] + sum_partial[i];
        sR[i+1][9]  = sR[i][9] * POSEIDON_DIAG[9] + sum_partial[i];
        sR[i+1][10]  = sR[i][10] * POSEIDON_DIAG[10] + sum_partial[i];
        sR[i+1][11]  = sR[i][11] * POSEIDON_DIAG[11] + sum_partial[i];
        sR[i+1][12]  = sR[i][12] * POSEIDON_DIAG[12] + sum_partial[i];
        sR[i+1][13]  = sR[i][13] * POSEIDON_DIAG[13] + sum_partial[i];
        sR[i+1][14]  = sR[i][14] * POSEIDON_DIAG[14] + sum_partial[i];
        sR[i+1][15]  = sR[i][15] * POSEIDON_DIAG[15] + sum_partial[i];
    }

    for (int i = 0; i < POSEIDON_WIDTH; i++) {
       sel * (output[i] - sR[rounds][i]) === 0;
    }
}

function plonk(const expr a[], const expr c[], const expr sel) {
    sel * (c[0]*(a[0]*a[1]) + c[1]*a[0] + c[2]*a[1] + c[3]*a[2] + c[4]) === 0;
}

// CMUL GATE - Check that a * b in Fp³ using (X³ - X - 1) as a generator is performed correctly

// Since the modulo is known (X³ - X - 1) we can calculate the coefficients in general form by calculating 
// (a0 + a1*x + a2*x²)*(b0 + b1*x + b2*x²) and then using long division to get the residue when dividing by the modulo
// We get the following result: (a0*b0 + a1*b2 + a2*b1) + (a0*b1 + a1*b0 + a1*b2 + a2*b1 + a2*b2)x + (a0*b2 + a2*b2 + a2*b0 + a1*b1)x²
function cmul(const expr a[], const expr b[], const expr res[], const expr sel) {
    sel * (res[0] - (a[0]*b[0] + a[1]*b[2] + a[2]*b[1])) === 0;
    sel * (res[1] - (a[0]*b[1] + a[1]*b[0] + a[1]*b[2] + a[2]*b[1] + a[2]*b[2])) === 0;
    sel * (res[2] - (a[0]*b[2] + a[2]*b[2] + a[2]*b[0] + a[1]*b[1])) === 0;
}

function fft4(const expr a[], const expr c[], const expr res[], const expr sel) {
    sel * (res[0] - (c[0]*a[0] + c[1]*a[3] + c[2]*a[6] + c[3]*a[9]  + c[6]*a[0] + c[7]*a[3])) === 0;
    sel * (res[1] - (c[0]*a[1] + c[1]*a[4] + c[2]*a[7] + c[3]*a[10] + c[6]*a[1] + c[7]*a[4])) === 0;
    sel * (res[2] - (c[0]*a[2] + c[1]*a[5] + c[2]*a[8] + c[3]*a[11] + c[6]*a[2] + c[7]*a[5])) === 0;
    sel * (res[3] - (c[0]*a[0] - c[1]*a[3] + c[4]*a[6] - c[5]*a[9]  + c[6]*a[0] - c[7]*a[3])) === 0;
    sel * (res[4] - (c[0]*a[1] - c[1]*a[4] + c[4]*a[7] - c[5]*a[10] + c[6]*a[1] - c[7]*a[4])) === 0;
    sel * (res[5] - (c[0]*a[2] - c[1]*a[5] + c[4]*a[8] - c[5]*a[11] + c[6]*a[2] - c[7]*a[5])) === 0;
    sel * (res[6] - (c[0]*a[0] + c[1]*a[3] - c[2]*a[6] - c[3]*a[9]  + c[6]*a[6] + c[8]*a[9])) === 0;
    sel * (res[7] - (c[0]*a[1] + c[1]*a[4] - c[2]*a[7] - c[3]*a[10] + c[6]*a[7] + c[8]*a[10])) === 0;
    sel * (res[8] - (c[0]*a[2] + c[1]*a[5] - c[2]*a[8] - c[3]*a[11] + c[6]*a[8] + c[8]*a[11])) === 0;
    sel * (res[9] - (c[0]*a[0] - c[1]*a[3] - c[4]*a[6] + c[5]*a[9]  + c[6]*a[6] - c[8]*a[9])) === 0;
    sel * (res[10] - (c[0]*a[1] - c[1]*a[4] - c[4]*a[7] + c[5]*a[10] + c[6]*a[7] - c[8]*a[10])) === 0;
    sel * (res[11] - (c[0]*a[2] - c[1]*a[5] - c[4]*a[8] + c[5]*a[11] + c[6]*a[8] - c[8]*a[11])) === 0;
}


// TREESELECTOR4 GATE - Check that given 4 values and a key, checks that the output is correct
// The tree is created as follows: if key = 0, even values are pushed up the tree, if the key = 1 the odd ones are pushed.
// Therefore, we need to check that 
// key == [0,0] -> [value1, value2, value3, value4] -> [value1, value3] -> [value1]
// key == [1,0] -> [value1, value2, value3, value4] -> [value2, value4] -> [value2]
// key == [0,1] -> [value1, value2, value3, value4] -> [value1, value3] -> [value3]
// key == [1,1] -> [value1, value2, value3, value4] -> [value2, value4] -> [value4]

// The values are stored from a[0], a[1], a[2] // a[3], a[4], a[5] // a[6], a[7], a[8] // a[9], a[10], a[11] 
// The key is stored in [a[12], a[13]]
// The output is stored in [a[14], a[15], a[16]]
function treeselector4(const expr vals[][], const expr key[], const expr res[], const expr sel) {

    const expr key00 = (1 - key[0]) * (1 - key[1]);
    const expr key10 = key[0] * (1 - key[1]);
    const expr key01 = (1 - key[0]) * key[1];
    const expr key11 = key[0] * key[1];

    sel * key00 * (vals[0][0] - res[0]) === 0;
    sel * key00 * (vals[0][1] - res[1]) === 0;
    sel * key00 * (vals[0][2] - res[2]) === 0;

    sel * key10 * (vals[1][0] - res[0]) === 0;
    sel * key10 * (vals[1][1] - res[1]) === 0;
    sel * key10 * (vals[1][2] - res[2]) === 0;

    sel * key01 * (vals[2][0] - res[0]) === 0;
    sel * key01 * (vals[2][1] - res[1]) === 0;
    sel * key01 * (vals[2][2] - res[2]) === 0;

    sel * key11 * (vals[3][0] - res[0]) === 0;
    sel * key11 * (vals[3][1] - res[1]) === 0;
    sel * key11 * (vals[3][2] - res[2]) === 0;

    sel * (key[0]*(1 - key[0])) === 0;
    sel * (key[1]*(1 - key[1])) === 0;
}

function selectval1(const expr vals[][], const expr key[], const expr res[], const expr sel) {

    const expr key00 = (1 - key[0]) * (1 - key[1]);
    const expr key10 = key[0] * (1 - key[1]);
    const expr key01 = (1 - key[0]) * key[1];
    const expr key11 = key[0] * key[1];

    sel * key00 * (vals[0][0] - res[0]) === 0;
    sel * key00 * (vals[0][1] - res[1]) === 0;
    sel * key00 * (vals[0][2] - res[2]) === 0;
    sel * key00 * (vals[0][3] - res[3]) === 0;

    sel * key10 * (vals[1][0] - res[0]) === 0;
    sel * key10 * (vals[1][1] - res[1]) === 0;
    sel * key10 * (vals[1][2] - res[2]) === 0;
    sel * key10 * (vals[1][3] - res[3]) === 0;

    sel * key01 * (vals[2][0] - res[0]) === 0;
    sel * key01 * (vals[2][1] - res[1]) === 0;
    sel * key01 * (vals[2][2] - res[2]) === 0;
    sel * key01 * (vals[2][3] - res[3]) === 0;

    sel * key11 * (vals[3][0] - res[0]) === 0;
    sel * key11 * (vals[3][1] - res[1]) === 0;
    sel * key11 * (vals[3][2] - res[2]) === 0;
    sel * key11 * (vals[3][3] - res[3]) === 0;

    sel * (key[0]*(1 - key[0])) === 0;
    sel * (key[1]*(1 - key[1])) === 0;
}

// EVPOL4 GATE - Check that the polynomial evaluation is valid
// Evaluate p(x) = d0*x⁴ + d1*x³ + d2*x²+ d3*x + d4 at point z = a[0]' + a[1]'x + a[2]'x² where
// d0 = a[0]' + a[1]' * x + a[2]' * x²
// d1 = a[9] + a[10] * x + a[11] * x²
// d2 = a[6] + a[7] * x + a[8] * x²
// d3 = a[3] + a[4] * x + a[5] * x²
// d4 = a[0] + a[1] * x + a[2] * x²
// The result must be equal to a[6]' + a[7]' * x + a[8]' * x²
// The evaluation is performed using the Horner's rule, which means that p(x) is rewritten as
// p(x) = (d0 * x + d1)*x + d2)*x + d3)*x + d4
// Note: All operations are performed in Fp³ and so multiplications are performed using CMulAdd
function evpol4(const expr coefs[][], const expr x[], const expr res[], const expr sel) {
    
    const expr acc[5][3];
    acc[0] = coefs[0];
    for(int i = 0; i < 4; i++) {
        acc[i + 1][0] = (acc[i][0]*x[0] + acc[i][1]*x[2] + acc[i][2]*x[1]) + coefs[i+1][0];
        acc[i + 1][1] = (acc[i][0]*x[1] + acc[i][1]*x[0] + acc[i][1]*x[2] + acc[i][2]*x[1] + acc[i][2]*x[2]) + coefs[i+1][1];
        acc[i + 1][2] = (acc[i][0]*x[2] + acc[i][2]*x[2] + acc[i][2]*x[0] + acc[i][1]*x[1]) + coefs[i+1][2];
    }

    sel * (acc[4][0] - res[0]) === 0;
    sel * (acc[4][1] - res[1]) === 0;
    sel * (acc[4][2] - res[2]) === 0;
}

airtemplate <%= namespaceName %> (const int N, const int nPlonkRows, const int nPoseidonCompressor, const int nPoseidonSponge, const int nCMulRows, const int nEvPol4, const int nFFT4, const int nTreeSelector4, const int nSelectVal1) {
    col witness a[62];

    #pragma fixed_external
    col fixed S[30];
    
    #pragma fixed_external
    col fixed C[10];
    
    const int nPoseidon = nPoseidonCompressor + nPoseidonSponge;

    col fixed POSEIDONSPONGE = [[1,0:4]:nPoseidonSponge,0...];
    col fixed POSEIDONCOMPRESSION = [[0:5]:nPoseidonSponge,[1,0:4]:nPoseidonCompressor,0...]; 
    col fixed POSEIDON_PARTIAL_ROUND = [[0:2,1,0:2]:nPoseidon,0...];
    col fixed POSEIDON_FINAL = [[0:4,1]:nPoseidon,0...];
   
    col fixed CMUL = [0:(5*nPoseidon),1:nCMulRows, 0...];
    col fixed EVPOL4 = [0:(5*nPoseidon + nCMulRows), 1:nEvPol4, 0...];
    col fixed FFT4 = [0:(5*nPoseidon + nCMulRows + nEvPol4), 1:nFFT4, 0...];
    col fixed TREESELECTOR4 = [0:(5*nPoseidon + nCMulRows + nEvPol4 + nFFT4), 1:nTreeSelector4, 0...];
    col fixed SELECTVAL1 = [0:(5*nPoseidon + nCMulRows + nEvPol4 + nFFT4 + nTreeSelector4), 1:nSelectVal1, 0...];

    col fixed PLONK = [0:(5*nPoseidon + nCMulRows + nEvPol4 + nFFT4 + nTreeSelector4 + nSelectVal1),1:nPlonkRows, 0...];

    const expr q0[5] = [C[0], C[1], C[2], C[3], C[4]];
    const expr q1[5] = [C[5], C[6], C[7], C[8], C[9]];

    const expr CHECK_PLONK = PLONK + POSEIDON_PARTIAL_ROUND' + POSEIDON_PARTIAL_ROUND + POSEIDON_FINAL';

    plonk([a[0], a[1], a[2]], q0, CHECK_PLONK);
    plonk([a[3], a[4], a[5]], q0, CHECK_PLONK);
    plonk([a[6], a[7], a[8]], q1, CHECK_PLONK);
    plonk([a[9], a[10], a[11]], q1, CHECK_PLONK);
    plonk([a[12], a[13], a[14]], q1, CHECK_PLONK);
    plonk([a[15], a[16], a[17]], q1, CHECK_PLONK);
    plonk([a[18], a[19], a[20]], q1, CHECK_PLONK + POSEIDON_FINAL + TREESELECTOR4);
    plonk([a[21], a[22], a[23]], q1, CHECK_PLONK + POSEIDON_FINAL + TREESELECTOR4 + EVPOL4);
    plonk([a[24], a[25], a[26]], q1, CHECK_PLONK + POSEIDON_FINAL + TREESELECTOR4 + EVPOL4 + POSEIDONSPONGE + POSEIDONCOMPRESSION + SELECTVAL1);
    plonk([a[27], a[28], a[29]], q1, CHECK_PLONK + POSEIDON_FINAL + TREESELECTOR4 + EVPOL4 + POSEIDONSPONGE + POSEIDONCOMPRESSION + SELECTVAL1);

    const expr b0 = a[16];
    const expr b1 = a[17];

    const expr inputO[POSEIDON_WIDTH];
    const expr outputO[POSEIDON_WIDTH];
    for (int i = 0; i < POSEIDON_WIDTH; i++) {
        inputO[i] = a[i];
        outputO[i] = a[30 + i];
    }
    poseidonInputOrder(inputO, [a[16], a[17]], outputO, POSEIDONSPONGE, POSEIDONCOMPRESSION);
    
    const int firstColP = 30;

    const expr inputP[POSEIDON_WIDTH];
    const expr outputP[POSEIDON_WIDTH];
    for (int i = 0; i < POSEIDON_WIDTH; i++) {
        inputP[i] = a[i + firstColP];
        outputP[i] = a[i + firstColP]';
    }

    const expr st0[22];
    for (int i = 0; i < 16; i++) {
        st0[i] = a[i + firstColP + 16];
    }
    for (int i = 0; i < 6; i++) {
        st0[16 + i] = (2)'a[i + 18];
    }
    
    const expr inputF_7[POSEIDON_WIDTH];
    const expr constantsPoseidonF[POSEIDON_WIDTH];
    const expr outputF[POSEIDON_WIDTH];
    const expr inputF2_7[POSEIDON_WIDTH];
    const expr constantsPoseidonF2[POSEIDON_WIDTH];
    const expr outputF2[POSEIDON_WIDTH];
    const expr intermediateValues[22];

    for (int i = 0; i < POSEIDON_WIDTH; i++) {
        constantsPoseidonF[i] = (POSEIDONSPONGE + POSEIDONCOMPRESSION) * POSEIDON_RC[i] + POSEIDON_PARTIAL_ROUND' * POSEIDON_RC[i + 32] + POSEIDON_FINAL' * POSEIDON_RC[i + 86] + POSEIDON_FINAL * POSEIDON_RC[i + 118];

        constantsPoseidonF2[i] = (POSEIDONSPONGE + POSEIDONCOMPRESSION) * POSEIDON_RC[i + 16] + POSEIDON_PARTIAL_ROUND' * POSEIDON_RC[i + 48] + POSEIDON_FINAL' * POSEIDON_RC[i + 102] + POSEIDON_FINAL * POSEIDON_RC[i + 134] + POSEIDON_PARTIAL_ROUND * POSEIDON_RC[i + 64];

        inputF_7[i] = pow7(a[i + firstColP] + constantsPoseidonF[i]);
        outputF[i] = a[i + firstColP + 16];
        inputF2_7[i] = pow7(a[i + firstColP + 16] + constantsPoseidonF2[i]);
        outputF2[i] = POSEIDON_FINAL * a[i] + (1 - POSEIDON_FINAL) * a[i + firstColP]';

        intermediateValues[i] = inputF2_7[i];
    }

    for (int i = 0; i < 6; i++) {
        intermediateValues[16 + i] = pow7((2)'a[i + 18] + POSEIDON_RC[80 + i]);
    }
    
    poseidonFullRound(inputF_7, outputF, POSEIDONSPONGE + POSEIDONCOMPRESSION + POSEIDON_PARTIAL_ROUND' + POSEIDON_FINAL' + POSEIDON_FINAL);
    poseidonFullRound(inputF2_7, outputF2, POSEIDONSPONGE + POSEIDONCOMPRESSION + POSEIDON_PARTIAL_ROUND' + POSEIDON_FINAL' + POSEIDON_FINAL);
    poseidonPartialRound(22, inputP, outputP, st0, intermediateValues, POSEIDON_PARTIAL_ROUND);

    const expr inA1[3] = [a[0], a[1], a[2]];
    const expr inB1[3] = [a[3], a[4], a[5]];
    const expr res[3] = [a[6], a[7], a[8]];
    cmul(inA1, inB1, res, CMUL);

    const expr inA2[3] = [a[9], a[10], a[11]];
    const expr inB2[3] = [a[12], a[13], a[14]];
    const expr res2[3] = [a[15], a[16], a[17]];
    cmul(inA2, inB2, res2, CMUL);

    const expr inA3[3] = [a[18], a[19], a[20]];
    const expr inB3[3] = [a[21], a[22], a[23]];
    const expr res3[3] = [a[24], a[25], a[26]];
    cmul(inA3, inB3, res3, CMUL);

    const expr inpFFT[12] = [a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11]];
    const expr outFFT[12] = [a[12], a[13], a[14], a[15], a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23]];
    const expr constFFT[9] = [C[0], C[1], C[2], C[3], C[4], C[5], C[6], C[7], C[8]];
    fft4(inpFFT, constFFT, outFFT, FFT4);

    const expr coefs[5][3];
    coefs[0] = [a[12], a[13], a[14]];
    coefs[1] = [a[9], a[10], a[11]];
    coefs[2] = [a[6], a[7], a[8]];
    coefs[3] = [a[3], a[4], a[5]];
    coefs[4] = [a[0], a[1], a[2]];
    const expr x[3] = [a[15], a[16], a[17]];
    const expr resEVPOL[3] = [a[18], a[19], a[20]];
    evpol4(coefs, x, resEVPOL, EVPOL4);
   
    const expr treevals[4][3];
    treevals[0] = [a[0], a[1], a[2]];
    treevals[1] = [a[3], a[4], a[5]];
    treevals[2] = [a[6], a[7], a[8]];
    treevals[3] = [a[9], a[10], a[11]];
    const expr key[2] = [a[12], a[13]];
    const expr resTREE[3] = [a[14], a[15], a[16]];
    treeselector4(treevals, key, resTREE, TREESELECTOR4);

    const expr selectvals[4][4];
    selectvals[0] = [a[0], a[1], a[2], a[3]];
    selectvals[1] = [a[4], a[5], a[6], a[7]];
    selectvals[2] = [a[8], a[9], a[10], a[11]];
    selectvals[3] = [a[12], a[13], a[14], a[15]];
    const expr selectvals_key[2] = [a[16], a[17]];
    const expr selected[4] = [a[18], a[19], a[20], a[21]];
    selectval1(selectvals, selectvals_key, selected, SELECTVAL1);

    const expr A[30];
    for (int i = 0; i < 30; i++) {
        A[i] = a[i];
    }
    connection(1, A, S, PIOP_BUS_PROD);
}

set_std_mode(STD_MODE_ONE_INSTANCE);

